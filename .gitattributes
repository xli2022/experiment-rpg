* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.glb binary
*.blend binary

# Keep third-party source data and license notices byte-for-byte intact.
assets/characters/source/** -text -whitespace
assets/animations/quaternius/License.txt -text -whitespace
assets/animations/quaternius/README.txt -text -whitespace
